{
  "services": {
    "frontend": {
      "root": ".",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "index.html"
        }
      ]
    },
    "backend": {
      "entrypoint": "src/server.ts",
      "root": "server/"
    }
  },

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}