{
  "services": {
    "frontend": {
      "root": "."
    },
    "backend": {
      "entrypoint": "src/server.ts",
      "root": "server/"
    }
  },

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/src/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}